# ===== Database =====
# Dialect: sqlite | postgresql
DB_DIALECT=sqlite

# For sqlite: filesystem path to the database file
DB_SQLITE_PATH=./data/sandbox.db

# For postgresql: full connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/sandbox_platform

# ===== Server =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ===== Auth =====
# JWT signing secret. REQUIRED in production: the platform refuses to start
# (NODE_ENV=production) with the placeholder or a secret shorter than 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Default admin credentials seeded on first migrate.
# REQUIRED in production: 'changeme123' is refused under NODE_ENV=production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123

# ===== Executor =====
# Which sandbox executor to use: mock | ssh | apptainer-cli
EXECUTOR_KIND=mock

# --- SSH executor (when EXECUTOR_KIND=ssh) ---
# Optional: default node connection target. Per-container node can override.
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PRIVATE_KEY_PATH=
# SSH_PASSWORD=                # alternative to private key

# --- Apptainer CLI executor (when EXECUTOR_KIND=apptainer-cli) ---
# Path to the apptainer binary (default: auto-detect on PATH)
APPTAINER_BIN=apptainer
# Base directory for overlay/ext3 storage
OVERLAY_BASE_DIR=./data/overlays
# Base directory for SIF image cache
IMAGE_BASE_DIR=./data/images
# Base directory for persistent user workspaces (seeded into containers on create)
WORKSPACE_BASE_DIR=./data/workspaces
