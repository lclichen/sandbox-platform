# ===== Database =====
# Dialect: sqlite | postgresql
DB_DIALECT=sqlite

# For sqlite: filesystem path to the database file
DB_SQLITE_PATH=./data/sandbox.db

# For postgresql: full connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/sandbox_platform

# ===== Server =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Reverse-proxy hops (0 = direct client). Needed behind a load balancer so
# rate limiting keys on the real client IP instead of the proxy IP.
TRUST_PROXY=0

# Optional bearer token guarding GET /metrics. Unset = 503 unless METRICS_PUBLIC=on.
# When set, Prometheus must scrape with: -H "Authorization: Bearer <METRICS_TOKEN>"
# Generate with: openssl rand -hex 24
# METRICS_TOKEN=
# METRICS_PUBLIC=on            # expose /metrics without a token (trusted LAN only)

# ===== Rate limiting (P1-1) =====
# Enabled by default in EVERY environment; set to false only for local tests.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_BASH_PER_MINUTE=60

# ===== Auth =====
# JWT signing secret. Known placeholders are REFUSED in every environment.
# Unset (default) → a random ephemeral secret is generated per process (all
# logins drop on restart — fine for a first look, not for real use).
# Generate a persistent one with: openssl rand -hex 32
# JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Default admin credentials seeded on first migrate.
# Seeding with 'changeme123' still works locally but the account starts behind
# the forced-password-change gate (login works, nothing else does until changed).
# REQUIRED in production: 'changeme123' is refused under NODE_ENV=production.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123

# ===== Executor =====
# Which sandbox executor to use: auto | ssh | apptainer-cli | mock
#  - auto (default): probe ssh (needs SSH_HOST) then apptainer-cli; startup
#    FAILS when neither is usable — a misconfigured host never silently
#    degrades to an unisolated mock.
#  - mock: LOCAL DEV/TEST ONLY. Runs user shells on the platform host with NO
#    isolation (env scrubbed to a safe allowlist). Refused in production.
EXECUTOR_KIND=mock

# --- SSH executor (when EXECUTOR_KIND=ssh) ---
# Optional: default node connection target. Per-container node can override.
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PRIVATE_KEY_PATH=
# SSH_PASSWORD=                # alternative to private key

# --- Apptainer CLI executor (when EXECUTOR_KIND=apptainer-cli) ---
# Path to the apptainer binary (default: auto-detect on PATH)
APPTAINER_BIN=apptainer
# Apply --cpus/--memory resource limits to instance start. Requires cgroup
# support on the host (setuid install or cgroups v2); rootless + cgroup v1
# fails instance start with "rootless cgroups requires cgroups v2".
# Default OFF; container cpu/memory settings still stored/shown in the UI.
APPTAINER_RESOURCE_LIMITS=false
# Base directory for overlay/ext3 storage
OVERLAY_BASE_DIR=./data/overlays
# Base directory for SIF image cache
IMAGE_BASE_DIR=./data/images
# Base directory for persistent user workspaces (seeded into containers on create)
WORKSPACE_BASE_DIR=./data/workspaces

# ===== Reaper (idle container auto-release, manual §5.1) =====
# Background sweep: running containers idle longer than IDLE_AUTO_STOP_HOURS
# are snapshot (Stop-Then-Copy) then stopped; the next start/connect resumes
# from the auto snapshot automatically.
REAPER_ENABLED=false
REAPER_INTERVAL_MINUTES=30
IDLE_AUTO_STOP_HOURS=168          # 1 week
IDLE_AUTO_STOP_SNAPSHOT=true      # strongly recommended; releases a consistent state
IDLE_AUTO_STOP_SNAPSHOT_TIER=auto # snapshot name prefix (auto-<ts>)
# Audit log retention; expired operation_logs are purged by the reaper sweep.
# 0 disables purging.
AUDIT_RETENTION_DAYS=90

# ===== LLM integration (LiteLLM proxy, optional) =====
# Master switch. When false, every /api/v1/*llm* route returns 503 and the
# platform behaves as if LiteLLM does not exist.
LLM_ENABLED=false

# AES-256-GCM key used to encrypt LiteLLM virtual-key plaintext at rest (the
# platform must return these to users later, so they cannot be one-way hashed).
# REQUIRED when LLM_ENABLED=true. Generate with: openssl rand -hex 32
LLM_ENCRYPTION_KEY=

# Endpoint the platform uses to call LiteLLM management APIs.
LITELLM_BASE_URL=http://localhost:4000
# Endpoint given to users/containers to drive LLM traffic directly. Usually the
# same as LITELLM_BASE_URL, but may differ behind a reverse proxy.
LITELLM_PUBLIC_BASE_URL=http://localhost:4000

# LiteLLM master key (must start with 'sk-'). Used to authenticate management
# calls (create user, generate key, read spend). REQUIRED when LLM_ENABLED=true.
# Generate with: openssl rand -hex 24   (then prefix with 'sk-')
LITELLM_MASTER_KEY=

# Per-request timeout for LiteLLM management calls (ms).
LITELLM_TIMEOUT_MS=30000

# ===== Self-registration (R1, pi-web integration) =====
# off (default): POST /api/v1/auth/register answers 404 — behavior identical
#                to before; accounts are admin-created only.
# open:          anyone can register; accounts are active immediately.
# approval:      registrations land as status=pending and an admin must
#                approve them (Users page approval queue) before login.
REGISTER_MODE=off
# resource_quotas.name assigned to self-registered accounts.
REGISTER_DEFAULT_QUOTA_NAME=default

# ===== Password policy (R9) =====
# Minimum length applied to register/admin-create/password-change.
PASSWORD_MIN_LENGTH=8
# When true, passwords must mix upper-case, lower-case, and digits.
PASSWORD_REQUIRE_COMPLEXITY=false
# Registration rate limit (per IP per minute, when RATE_LIMIT_ENABLED=true).
RATE_LIMIT_REGISTER_PER_MINUTE=5

# ===== Interactive terminals (R2, WebSocket) =====
# Concurrent PTY sessions per container.
PTY_MAX_PER_CONTAINER=3
# Kill terminal sessions with no client traffic for this many minutes.
PTY_IDLE_TIMEOUT_MINUTES=30

# ===== Workspace uploads & tree (R5) =====
# Hard cap for a single uploaded file, in bytes (chunked or direct).
WORKSPACE_UPLOAD_MAX_BYTES=209715200
# Directory names skipped by GET /workspaces/:id/tree (comma-separated).
WORKSPACE_TREE_IGNORE=node_modules,.git,dist,build
# Incomplete chunked uploads older than this are swept on next upload start.
WORKSPACE_UPLOAD_TTL_HOURS=24

# ===== One-click provisioning defaults (R6) =====
# Image id + template workspace id offered to pi-web for "new user first
# session" provisioning. 0/unset = fall back to the first public image / none.
PROVISION_DEFAULT_IMAGE_ID=0
PROVISION_DEFAULT_WORKSPACE_ID=0
