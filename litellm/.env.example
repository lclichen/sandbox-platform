# =============================================================================
# LiteLLM Proxy secrets. Copy to .env and fill in real values.
# =============================================================================

# Management credential — authenticates the platform's calls to LiteLLM's
# management API (/user/*, /key/*, /spend/*). MUST start with 'sk-'.
# Generate:  openssl rand -hex 24   then prefix with 'sk-'
# IMPORTANT: copy this SAME value into the platform's sandbox-platform/.env as
# LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=sk-changeme-generate-with-openssl

# Encryption salt for provider credentials stored in the LiteLLM DB.
# Generate:  openssl rand -hex 32
# WARNING: once any model credential is stored, this CANNOT be rotated (old
# ciphertext becomes undecryptable). Set it once and back it up.
LITELLM_SALT_KEY=

# LiteLLM's dedicated Postgres credentials. These only need to be secure; the
# platform never connects to this DB directly.
LITELLM_PG_USER=litellm
LITELLM_PG_PASSWORD=changeme
LITELLM_PG_DB=litellm

# Provider API keys — uncomment and set those you reference in config.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
