{
  "name": "sandbox-platform",
  "version": "0.1.0",
  "description": "Centralized Apptainer-based cloud-native sandbox management platform",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node --experimental-transform-types --no-warnings=ExperimentalWarning src/index.ts",
    "dev": "node --watch --experimental-transform-types --no-warnings=ExperimentalWarning src/index.ts",
    "build": "npm run typecheck",
    "build:all": "npm run typecheck",
    "setup": "npm install && npm run migrate",
    "migrate": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/migrate.ts",
    "migrate:rollback": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/migrate.ts rollback",
    "seed": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/migrate.ts seed",
    "backup": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/backup.ts",
    "restore": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/restore.ts",
    "migrate-db": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/migrate-db.ts",
    "reset-admin-password": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/reset-admin-password.ts",
    "rotate-llm-key": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/rotate-llm-key.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.16",
    "node-ssh": "^13.2.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "safe-regex2": "^5.1.2",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
